# Copy to .env and replace every REPLACE_WITH_* value. .env is git-ignored.
# It is read by `npm run upload` (deploy) and by `npm start`/`npm run build`
# (only REACT_APP_* variables are exposed to the browser bundle).

# S3 bucket the site is uploaded to, e.g. dustinatwood.com
SITE=REPLACE_WITH_S3_BUCKET_NAME
# CloudFront distribution ID to invalidate after upload, e.g. E1ABCDEF2GHIJK
DIS=REPLACE_WITH_CLOUDFRONT_DISTRIBUTION_ID
# Named profile in ~/.aws/credentials with S3 + CloudFront permissions
AWS_PROFILE=REPLACE_WITH_AWS_PROFILE

# Formspree form ID: the part after /f/ in https://formspree.io/f/<id>
REACT_APP_FORMSPREE_ID=REPLACE_WITH_FORMSPREE_FORM_ID
